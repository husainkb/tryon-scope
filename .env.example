SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions
SHOPIFY_APP_URL=

# MongoDB connection string. In development this is unused (the app
# connects to mongodb://127.0.0.1:27017/tryon); set this for production.
MONGODB_URI=mongodb://127.0.0.1:27017/tryon
