{%- comment -%}
  Renders the JSON data island the try-on widget reads to know which
  product/variants it's mounted on. Expects `product`.
{%- endcomment -%}
{
  "productId": "gid://shopify/Product/{{ product.id }}",
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "variants": [
    {%- for variant in product.variants -%}
    {
      "variantId": "gid://shopify/ProductVariant/{{ variant.id }}",
      "title": {{ variant.title | json }},
      "available": {{ variant.available | json }},
      "image": {{ variant.featured_image.src | default: product.featured_image.src | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
